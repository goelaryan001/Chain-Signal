# Copy to .env and fill in. .env is git-ignored.

# CoinGecko Demo API key: https://www.coingecko.com/en/api/pricing (free "Demo" plan)
COINGECKO_API_KEY=

# Etherscan API key: https://etherscan.io/myapikey (free account)
ETHERSCAN_API_KEY=

# ClickHouse (matches docker-compose.yml)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=chainsignal
CLICKHOUSE_PASSWORD=chainsignal
CLICKHOUSE_DB=chainsignal
